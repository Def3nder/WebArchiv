{
  "name": "webarchiv",
  "version": "1.0.0",
  "description": "Article archive viewer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node scraper/scrape_all.js",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test --test-isolation=none \"test/*.test.cjs\" \"scraper/test/*.test.js\" \"epub-tool/test/*.test.js\" \"tts/test/*.test.cjs\" \"tts/test/*.test.js\"",
    "test:python": "python -B -m unittest discover -s tts/test -p \"test_*.py\" -v"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "fuse.js": "^7.3.0",
    "marked": "^9.1.6",
    "sharp": "^0.35.3"
  }
}
