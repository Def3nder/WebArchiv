{
  "name": "webarchiv",
  "version": "1.0.0",
  "description": "Article archive viewer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node scraper/scrape_all.js",
    "build:editor": "esbuild public/markdown-editors.js --bundle --minify --format=iife --target=es2020 --outfile=public/vendor/article-editor.bundle.js --legal-comments=linked",
    "build:duplicate-diff": "esbuild public/duplicate-diff.js --bundle --minify --format=iife --target=es2020 --global-name=duplicateTextDiff --outfile=public/vendor/duplicate-diff.bundle.js --legal-comments=linked",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test --test-isolation=none \"test/*.test.cjs\" \"scraper/test/*.test.js\" \"epub-tool/test/*.test.js\" \"tts/test/*.test.cjs\" \"tts/test/*.test.js\"",
    "test:python": "python -B -m unittest discover -s tts-server/test -p \"test_*.py\" -v"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "diff": "^8.0.4",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "fuse.js": "^7.3.0",
    "marked": "^9.1.6",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/markdown": "^1.8.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
